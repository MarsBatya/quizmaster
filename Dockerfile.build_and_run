# STAGE 1: Build the binary
FROM eclipse-temurin:11-jdk AS builder

ARG SBT_VERSION=1.6.2

WORKDIR /app
RUN \
  mkdir /working/ && \
  cd /working/ && \
  curl -L -o sbt-$SBT_VERSION.deb https://repo.scala-sbt.org/scalasbt/debian/sbt-$SBT_VERSION.deb && \
  dpkg -i sbt-$SBT_VERSION.deb && \
  rm sbt-$SBT_VERSION.deb && \
  apt-get update && \
  apt-get install -y sbt && \
  cd && \
  rm -r /working/ && \
  sbt sbtVersion
WORKDIR /src
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y nodejs unzip

# Copy only dependency files first
COPY build.sbt .
COPY project/ project/

# Resolve and cache all dependencies as a separate layer
RUN sbt -mem 4096 update

# Copy the rest of the source
COPY . .

# This layer only reruns if source code changed, deps are already cached
RUN sbt -mem 4096 dist

RUN mkdir dist
RUN cd dist && unzip /src/app/jvm/target/universal/*.zip


# STAGE 2: Run the binary
FROM eclipse-temurin:11-jre

COPY --from=builder /src/dist/server-1.0 /app

WORKDIR /app